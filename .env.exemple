# ================================
# APPLICATION
# ================================
APP_NAME=rag-agent-system
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

# ================================
# API SERVER
# ================================
API_HOST=0.0.0.0
API_PORT=8000

# ================================
# OPENROUTER (Phase 3+)
# ================================
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ================================
# CHROMADB (Phase 2+)
# ================================
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_NAME=rag_documents

# ================================
# LOGGING
# ================================
LOG_LEVEL=INFO